# 复制为 .env 后仅在本机填写。所有可选功能均需自行申请密钥。
# npm start 会加载本文件的本机副本 .env；不要把 .env 提交到 Git。
# 下列值全部刻意留空；不用的服务保持空白。
HEFENG_WEATHER_API_HOST=
HEFENG_WEATHER_API_KEY=
GAODE_WEB_API_KEY=
TENGXUNDITU_API_KEY=
TIANDITU_API_KEY=
BAIDUDITU_API_KEY=
BOCHA_API_KEY=
DEEPSEEK_API_KEY=
YUANBAO_SEARCH_API_KEY=
ANYSEARCH_API_KEY=
QWEN_API_KEY=
BAILIAN_API_KEY=
DASHSCOPE_API_KEY=
DOUBAO_API_KEY=

# 可选：本机可执行文件与工作台受保护配置（不填真实凭据到仓库）
FFMPEG_PATH=
FFPROBE_PATH=
QQ_WORKBENCH_DB_FILE=
QQ_WORKBENCH_OSS_FILE=

# 可选：服务器图文结果卡片的完整中文字体，不是网页像素字集
QQ_CARD_FONT=
